# Next.js Frontend Environment Variables

# Backend API endpoint (defaults to /api which proxies through Next.js rewrites)
NEXT_PUBLIC_API_URL=/api

# Express Backend URL used by Next.js rewrites
# In local development: http://127.0.0.1:5000
# On Vercel: Set this in Vercel Project Settings to your deployed backend (e.g., https://your-backend.railway.app)
BACKEND_URL=http://127.0.0.1:5000
